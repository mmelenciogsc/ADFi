root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

[*.{json,yml,yaml,xml,props,targets,csproj,slnx,md,sh,ps1,cmd}]
indent_style = space
indent_size = 2

[*.sh]
end_of_line = lf

