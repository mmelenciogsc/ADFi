<Window x:Class="ADFi.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADFi"
        Width="1100"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="ADFi accessible media application">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="ADFi"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="4,0,4,12"
                   AutomationProperties.HeadingLevel="Level1" />

        <StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Ready. DISCOVER is available without signing in."
                       AutomationProperties.Name="Application status"
                       AutomationProperties.LiveSetting="Polite" />
        </StatusBar>

        <TabControl x:Name="PrimaryNavigation"
                    SelectedIndex="1"
                    AutomationProperties.Name="Primary navigation"
                    SelectionChanged="PrimaryNavigation_OnSelectionChanged">
            <TabItem Header="_MY ADFi" AutomationProperties.Name="MY ADFi">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="16" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="MY ADFi"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Margin="0,4,0,16"
                                   TextWrapping="Wrap"
                                   Text="Sign in to manage your private account, playlists, projects, drafts, collaborations, connected services, referrals, and earnings." />

                        <GroupBox Header="Account" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock Text="Not signed in" FontWeight="SemiBold" />
                                <Button Content="_Sign in" AutomationProperties.Name="Sign in to MY ADFi" HorizontalAlignment="Left" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Creator tools" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="A Creator subscription is required to create or conversationally edit an ADFied work." />
                                <CheckBox x:Name="RightsAttestationCheckBox"
                                          Margin="4,12"
                                          Content="I confirm that I own this media or have all rights/authorization necessary to process, modify and publish this ADFied version."
                                          AutomationProperties.Name="Rights and authorization confirmation"
                                          AutomationProperties.HelpText="Required before selecting a local source video. This confirmation is recorded but is not independent proof of ownership." />
                                <WrapPanel>
                                    <Button Content="Select _local video"
                                            IsEnabled="False"
                                            AutomationProperties.Name="Select local source video"
                                            AutomationProperties.HelpText="Available to signed-in Creator subscribers after rights confirmation." />
                                    <Button Content="_Resume project"
                                            IsEnabled="False"
                                            AutomationProperties.Name="Resume an ADFication project" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Earnings">
                            <StackPanel Margin="8">
                                <TextBlock Text="Pending: $0.00" />
                                <TextBlock Text="Available: $0.00" />
                                <TextBlock Text="On hold or disputed: $0.00" />
                                <TextBlock Text="Lifetime earnings: $0.00" />
                                <Button Content="View earnings _details"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="View explainable earnings details" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_DISCOVER" AutomationProperties.Name="DISCOVER">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="DISCOVER"
                               FontSize="24"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Grid.Row="1"
                               Margin="0,4,0,12"
                               TextWrapping="Wrap"
                               Text="Explore eligible public ADFied works, accessibility details, attribution, playlists, and qualified community feedback. No login is required to browse." />
                    <ListView Grid.Row="2"
                              x:Name="DiscoverProjects"
                              AutomationProperties.Name="Public ADFied works"
                              SelectionMode="Single">
                        <ListViewItem AutomationProperties.Name="No published projects are available yet">
                            <TextBlock Text="No published projects are available yet." />
                        </ListViewItem>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

