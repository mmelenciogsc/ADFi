<Window x:Class="ADFi.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADFi"
        Width="1160"
        Height="820"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_OnLoaded"
        Closed="MainWindow_OnClosed"
        AutomationProperties.Name="ADFi accessible media application">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="ADFi"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="4,0,4,12"
                   AutomationProperties.HeadingLevel="Level1" />

        <StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Starting ADFi."
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Application status"
                       AutomationProperties.LiveSetting="Polite" />
        </StatusBar>

        <TabControl x:Name="PrimaryNavigation"
                    SelectedIndex="1"
                    AutomationProperties.Name="Primary navigation"
                    SelectionChanged="PrimaryNavigation_OnSelectionChanged">
            <TabItem Header="_MY ADFi" AutomationProperties.Name="MY ADFi">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="16" MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Text="MY ADFi"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Margin="0,4,0,16"
                                   TextWrapping="Wrap"
                                   Text="Your private account, subscriptions, local projects, review tools, connected services, referrals, and earnings." />

                        <GroupBox Header="Account" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="AccountStateText"
                                           Text="Not signed in."
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Account state" />

                                <StackPanel x:Name="SignedOutPanel" Margin="0,8,0,0">
                                    <Label Target="{Binding ElementName=EmailTextBox}" Content="_Email address" />
                                    <TextBox x:Name="EmailTextBox"
                                             TabIndex="1"
                                             AutomationProperties.Name="Email address"
                                             AutomationProperties.HelpText="Enter the verified email address for your ADFi account." />
                                    <Label Target="{Binding ElementName=PasswordInput}" Content="_Password" />
                                    <PasswordBox x:Name="PasswordInput"
                                                 MinHeight="32"
                                                 Margin="4"
                                                 TabIndex="2"
                                                 AutomationProperties.Name="Password"
                                                 AutomationProperties.HelpText="Your password is sent only to the configured ADFi server over HTTPS and is never stored by this app." />
                                    <WrapPanel>
                                        <Button x:Name="SignInButton"
                                                Content="_Sign in"
                                                TabIndex="3"
                                                IsDefault="True"
                                                Click="SignInButton_OnClick"
                                                AutomationProperties.Name="Sign in to MY ADFi" />
                                        <Button Content="Request password _reset"
                                                TabIndex="4"
                                                Click="PasswordResetButton_OnClick"
                                                AutomationProperties.Name="Request a password reset email" />
                                    </WrapPanel>

                                    <Expander Header="Create an ADFi account"
                                              Margin="4,8,4,0"
                                              AutomationProperties.Name="Create an ADFi account">
                                        <StackPanel Margin="8">
                                            <Label Target="{Binding ElementName=RegistrationNameTextBox}" Content="Display _name" />
                                            <TextBox x:Name="RegistrationNameTextBox"
                                                     TabIndex="5"
                                                     AutomationProperties.Name="New account display name" />
                                            <Label Target="{Binding ElementName=RegistrationEmailTextBox}" Content="E_mail address" />
                                            <TextBox x:Name="RegistrationEmailTextBox"
                                                     TabIndex="6"
                                                     AutomationProperties.Name="New account email address" />
                                            <Label Target="{Binding ElementName=RegistrationPasswordInput}" Content="New _password" />
                                            <PasswordBox x:Name="RegistrationPasswordInput"
                                                         MinHeight="32"
                                                         Margin="4"
                                                         TabIndex="7"
                                                         AutomationProperties.Name="New account password" />
                                            <Label Target="{Binding ElementName=RegistrationPasswordConfirmationInput}" Content="_Confirm password" />
                                            <PasswordBox x:Name="RegistrationPasswordConfirmationInput"
                                                         MinHeight="32"
                                                         Margin="4"
                                                         TabIndex="8"
                                                         AutomationProperties.Name="Confirm new account password" />
                                            <Button Content="_Create account"
                                                    TabIndex="9"
                                                    HorizontalAlignment="Left"
                                                    Click="RegisterButton_OnClick"
                                                    AutomationProperties.Name="Create ADFi account" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <StackPanel x:Name="SignedInPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock x:Name="SubscriptionStateText"
                                               Text="Subscription access has not been verified."
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Subscription state" />
                                    <WrapPanel>
                                        <Button Content="_Refresh access"
                                                TabIndex="10"
                                                Click="RefreshEntitlementButton_OnClick"
                                                AutomationProperties.Name="Refresh subscription access" />
                                        <Button Content="Sign _out"
                                                TabIndex="11"
                                                Click="SignOutButton_OnClick"
                                                AutomationProperties.Name="Sign out of MY ADFi" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Accessible Interactive Video Viewer" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Community: Watch + Ask + Contribute + Refer + Earn. Creator: everything in Community plus ADFi, Create, Edit, Render, and Publish. Viewer questions are read-only." />
                                <Button x:Name="OpenInteractiveViewerButton"
                                        Content="_Open Video — Pause. Ask. Know. Resume."
                                        TabIndex="12"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Click="OpenInteractiveViewerButton_OnClick"
                                        AutomationProperties.Name="Open Accessible Interactive Video Viewer"
                                        AutomationProperties.HelpText="Open a local video file or paste a YouTube URL. A current Community or Creator subscription is required for moment questions." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Creator tools" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="A current server-verified Creator subscription is required. Source intake accepts supported local video files only." />
                                <TextBlock x:Name="HardwareProfileText"
                                           Margin="4,8,4,0"
                                           Text="Creator hardware has not been profiled for this Windows account."
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Creator hardware profile status" />
                                <Button x:Name="RunHardwareProfileButton"
                                        Content="Run _hardware profile"
                                        TabIndex="13"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Click="RunHardwareProfileButton_OnClick"
                                        AutomationProperties.Name="Run Creator hardware profile and miniature benchmark"
                                        AutomationProperties.HelpText="Measures free resources and a bounded local transcode and model sample, then unloads the model." />
                                <CheckBox x:Name="RightsAttestationCheckBox"
                                          Margin="4,12"
                                          TabIndex="14"
                                          Content="I confirm that I own this media or have all rights/authorization necessary to process, modify and publish this ADFied version."
                                          AutomationProperties.Name="Rights and authorization confirmation"
                                          AutomationProperties.HelpText="Required before selecting a local source video. This confirmation is recorded but is not independent proof of ownership."
                                          Checked="RightsAttestationCheckBox_OnChanged"
                                          Unchecked="RightsAttestationCheckBox_OnChanged" />
                                <WrapPanel>
                                    <Button x:Name="SelectLocalVideoButton"
                                            Content="Select _local video"
                                            TabIndex="15"
                                            IsEnabled="False"
                                            Click="SelectLocalVideoButton_OnClick"
                                            AutomationProperties.Name="Select local source video"
                                            AutomationProperties.HelpText="Available after a current Creator entitlement is verified and rights confirmation is checked." />
                                    <Button x:Name="CancelOperationButton"
                                            Content="_Cancel current operation"
                                            TabIndex="16"
                                            IsEnabled="False"
                                            Click="CancelOperationButton_OnClick"
                                            AutomationProperties.Name="Cancel current local processing operation" />
                                </WrapPanel>

                                <TextBlock Text="Local projects"
                                           Margin="4,12,4,4"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <ListBox x:Name="LocalProjectsList"
                                         MinHeight="90"
                                         MaxHeight="210"
                                         TabIndex="17"
                                         SelectionChanged="LocalProjectsList_OnSelectionChanged"
                                         AutomationProperties.Name="Local ADFication projects"
                                         AutomationProperties.HelpText="Use the arrow keys to select a project and hear its latest verified checkpoint.">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccessibleLabel}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="SelectedProjectText"
                                           Margin="4"
                                           Text="No local project selected."
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Selected project details" />
                                <Button x:Name="OpenLocalProjectButton"
                                        Content="_Open selected project for review"
                                        TabIndex="18"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Click="OpenLocalProjectButton_OnClick"
                                        AutomationProperties.Name="Open selected local project for review" />
                                <Button x:Name="RunPreparationButton"
                                        Content="_Run or resume audio and scene analysis"
                                        TabIndex="19"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Click="RunPreparationButton_OnClick"
                                        AutomationProperties.Name="Run or resume audio transcription and visual scene indexing"
                                        AutomationProperties.HelpText="Runs the next two bounded stages sequentially, saves each transcript chunk, unloads Whisper, then builds the keyframe scene index." />
                                <Button x:Name="RunVisualUnderstandingButton"
                                        Content="Continue with _characters, text, and scene understanding"
                                        TabIndex="20"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Click="RunVisualUnderstandingButton_OnClick"
                                        AutomationProperties.Name="Run or resume recurring character, on-screen text, and visual scene analysis"
                                        AutomationProperties.HelpText="Uses project-only anonymous face continuity, verifies meaningful text, and processes bounded scenes sequentially with Qwen." />
                                <Label Target="{Binding ElementName=NarrationVoiceComboBox}"
                                       Content="Narration _voice" />
                                <ComboBox x:Name="NarrationVoiceComboBox"
                                          TabIndex="21"
                                          DisplayMemberPath="AccessibleName"
                                          SelectedValuePath="Id"
                                          AutomationProperties.Name="Narration voice"
                                          AutomationProperties.HelpText="Choose one of five reviewed Piper voices for previews and generated audio description." />
                                <WrapPanel>
                                    <Button x:Name="PreviewNarrationVoiceButton"
                                            Content="_Preview selected voice"
                                            TabIndex="22"
                                            IsEnabled="False"
                                            Click="PreviewNarrationVoiceButton_OnClick"
                                            AutomationProperties.Name="Preview selected narration voice" />
                                    <Button x:Name="RunDraftNarrationButton"
                                            Content="Create _description draft and narration"
                                            TabIndex="23"
                                            IsEnabled="False"
                                            Click="RunDraftNarrationButton_OnClick"
                                            AutomationProperties.Name="Run or resume description selection, drafting, and Piper narration"
                                            AutomationProperties.HelpText="Selects quiet evidence-grounded description windows, drafts concise descriptions, then generates and measures one narration segment at a time." />
                                </WrapPanel>
                                <ProgressBar x:Name="PipelineProgressBar"
                                             Height="22"
                                             Margin="4"
                                             Minimum="0"
                                             Maximum="14"
                                             Value="0"
                                             AutomationProperties.Name="ADfication phase progress" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="ReviewGroup" Header="Project review and conversation" Margin="0,0,0,12" IsEnabled="False">
                            <StackPanel Margin="8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Creator review is enabled only for a selected local project with a current verified entitlement. Changes are proposed first and committed through validated project mutations." />
                                <Label Target="{Binding ElementName=DescriptionsList}" Content="Audio _descriptions" />
                                <ListBox x:Name="DescriptionsList"
                                         MinHeight="90"
                                         TabIndex="24"
                                         AutomationProperties.Name="Audio description segments" />
                                <Label Target="{Binding ElementName=ConversationTextBox}" Content="Project _request" />
                                <TextBox x:Name="ConversationTextBox"
                                         TabIndex="25"
                                         AutomationProperties.Name="Natural conversation project request"
                                         AutomationProperties.HelpText="Enter one request. ADFi will plan compound requests as dependency-safe atomic tasks." />
                                <WrapPanel>
                                    <Button x:Name="SubmitConversationButton"
                                            Content="_Submit request"
                                            TabIndex="26"
                                            IsEnabled="False"
                                            AutomationProperties.Name="Submit project request" />
                                    <Button Content="Play _around selection"
                                            TabIndex="27"
                                            IsEnabled="False"
                                            AutomationProperties.Name="Play preview around selected description" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Earnings" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock Text="Pending: unavailable until account services are connected" TextWrapping="Wrap" />
                                <TextBlock Text="Available: unavailable until account services are connected" TextWrapping="Wrap" />
                                <TextBlock Text="On hold or disputed: unavailable until account services are connected" TextWrapping="Wrap" />
                                <TextBlock Text="Lifetime earnings: unavailable until account services are connected" TextWrapping="Wrap" />
                                <Button Content="View earnings _details"
                                        TabIndex="28"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="View explainable earnings details" />
                            </StackPanel>
                        </GroupBox>

                        <Expander Header="Technical activity"
                                  Margin="4"
                                  TabIndex="29"
                                  AutomationProperties.Name="Technical activity for advanced users">
                            <TextBox x:Name="TechnicalActivityTextBox"
                                     Margin="8"
                                     MinHeight="110"
                                     TabIndex="30"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Technical activity log" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_DISCOVER" AutomationProperties.Name="DISCOVER">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="DISCOVER"
                               FontSize="24"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Grid.Row="1"
                               Margin="0,4,0,12"
                               TextWrapping="Wrap"
                               Text="Explore eligible public ADFied works, accessibility details, attribution, playlists, and qualified community feedback. No login is required to browse." />
                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                        <Button x:Name="RefreshDiscoverButton"
                                Content="_Refresh DISCOVER"
                                TabIndex="31"
                                Click="RefreshDiscoverButton_OnClick"
                                AutomationProperties.Name="Refresh public ADFied works" />
                        <TextBlock x:Name="DiscoverStateText"
                                   Margin="12,10,4,4"
                                   Text="Public projects have not been loaded."
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="DISCOVER loading state" />
                    </WrapPanel>
                    <ListView Grid.Row="3"
                              x:Name="DiscoverProjects"
                              TabIndex="32"
                              AutomationProperties.Name="Public ADFied works"
                              AutomationProperties.HelpText="Use arrow keys to select a work. Open it to use the official YouTube player on its ADFi page."
                              SelectionMode="Single"
                              SelectionChanged="DiscoverProjects_OnSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AccessibilitySummary, StringFormat=Accessibility: {0}}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Attribution, StringFormat=Attribution: {0}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                        <Button x:Name="OpenDiscoverProjectButton"
                                Content="_Open selected ADFi page"
                                TabIndex="33"
                                IsEnabled="False"
                                Click="OpenDiscoverProjectButton_OnClick"
                                AutomationProperties.Name="Open selected ADFi project page in the default browser"
                                AutomationProperties.HelpText="The project page uses the official YouTube player." />
                        <Button x:Name="CopyDiscoverProjectButton"
                                Content="_Copy selected project page"
                                TabIndex="34"
                                IsEnabled="False"
                                Click="CopyDiscoverProjectButton_OnClick"
                                AutomationProperties.Name="Copy selected ADFi project page address" />
                        <Button x:Name="OpenDiscoverViewerButton"
                                Content="Open in accessible _viewer"
                                TabIndex="35"
                                IsEnabled="False"
                                Click="OpenDiscoverViewerButton_OnClick"
                                AutomationProperties.Name="Open selected ADFi publication in the Accessible Interactive Video Viewer"
                                AutomationProperties.HelpText="Uses the official YouTube player and prefers existing ADFi accessibility evidence for moment questions." />
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
